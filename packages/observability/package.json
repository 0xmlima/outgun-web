{
  "name": "@outgun/observability",
  "version": "2.27.0",
  "private": true,
  "description": "Métricas Prometheus, logs estruturados e envio de erros (card OG-102).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
