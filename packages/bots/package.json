{
  "name": "@outgun/bots",
  "version": "2.31.0",
  "private": true,
  "description": "IA dos bots do Outgun (port de src/robot.cpp e src/bot_support.cpp): áreas do mapa, navegação, combate e decisões (cards OG-050 a OG-053).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@outgun/settings": "workspace:*",
    "@outgun/sim": "workspace:*"
  },
  "devDependencies": {
    "@outgun/content": "workspace:*",
    "@types/node": "^22.0.0"
  }
}
