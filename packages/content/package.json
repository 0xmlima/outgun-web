{
  "name": "@outgun/content",
  "version": "2.41.0",
  "private": true,
  "description": "Parser e gerador de mapas, manifesto de assets (cards OG-010, OG-011, OG-012).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./secret": {
      "types": "./dist/secret.d.ts",
      "default": "./dist/secret.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@outgun/sim": "workspace:*"
  }
}
