{
  "name": "@outgun/desktop",
  "version": "2.46.0",
  "private": true,
  "description": "Cliente para Windows, macOS e Ubuntu (OG-324, OG-326, D-58): uma janela do Electron que carrega o site do jogo.",
  "license": "GPL-2.0-or-later",
  "author": "Outgun Web",
  "homepage": "https://outgunweb.com.br",
  "type": "module",
  "main": "main.js",
  "desktopName": "outgun.desktop",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:linux": "electron-builder --linux deb --x64 --publish never",
    "dist:steam:win": "electron-builder --win dir --x64 --publish never",
    "dist:steam:mac": "electron-builder --mac dir --universal --publish never",
    "dist:steam:linux": "electron-builder --linux dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.outgunweb.desktop",
    "productName": "Outgun",
    "copyright": "GPL-2.0-or-later",
    "files": [
      "main.js",
      "display-win.js",
      "preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Outgun-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Outgun"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Outgun-mac-${version}.${ext}",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/steamworks.js/dist/osx/*",
      "files": [
        "!node_modules/koffi{,/**}",
        "!node_modules/@koromix{,/**}"
      ]
    },
    "dmg": {
      "title": "Outgun"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "Outgun Web",
      "synopsis": "Capture a bandeira com os amigos",
      "executableName": "outgun",
      "artifactName": "Outgun-linux-${version}.${ext}",
      "syncDesktopName": true,
      "files": [
        "!node_modules/koffi{,/**}",
        "!node_modules/@koromix{,/**}"
      ]
    },
    "deb": {
      "packageCategory": "games",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ]
    },
    "asarUnpack": [
      "node_modules/steamworks.js/dist/**",
      "node_modules/@koromix/**"
    ]
  },
  "dependencies": {
    "koffi": "3.3.2",
    "steamworks.js": "0.4.0"
  }
}
