{
  "name": "@outgun/desktop",
  "version": "2.31.0",
  "private": true,
  "description": "Cliente para Windows (OG-324, D-58): uma janela do Electron que carrega o site do jogo.",
  "license": "GPL-2.0-or-later",
  "author": "Outgun Web",
  "homepage": "https://outgunweb.com.br",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.outgunweb.desktop",
    "productName": "Outgun",
    "copyright": "GPL-2.0-or-later",
    "files": [
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Outgun-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Outgun"
    }
  }
}
