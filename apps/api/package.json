{
  "name": "@outgun/api",
  "version": "2.33.0",
  "private": true,
  "description": "API da plataforma: contas, ranking, salas (card OG-080).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "migrate": "node dist/cli.js migrate",
    "seed": "node dist/cli.js seed",
    "openapi": "node dist/cli.js openapi openapi.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@node-rs/argon2": "2.2.1",
    "@outgun/content": "workspace:*",
    "@outgun/observability": "workspace:*",
    "@outgun/protocol": "workspace:*",
    "@outgun/settings": "workspace:*",
    "@outgun/tickets": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
