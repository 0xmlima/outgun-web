{
  "openapi": "3.1.0",
  "info": {
    "title": "Outgun Web API",
    "version": "0.1.0",
    "description": "Contas, salas, partidas e ranking do Outgun Web. Rotas /internal: só game servers (HMAC).",
    "license": {
      "name": "GPL-2.0-or-later",
      "url": "https://spdx.org/licenses/GPL-2.0-or-later.html"
    }
  },
  "components": {
    "securitySchemes": {
      "gameServerHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "x-outgun-signature",
        "description": "HMAC-SHA256 hex de `timestamp.MÉTODO.caminho.sha256(corpo)` com o segredo do servidor; acompanhado de x-outgun-server e x-outgun-timestamp (ms)."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Estado da API e das dependências",
        "tags": ["sistema"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "version", "database", "redis"],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": ["ok"]
                        },
                        {
                          "type": "string",
                          "enum": ["degraded"]
                        }
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "database": {
                      "type": "boolean"
                    },
                    "redis": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": ["ok"]
                        },
                        {
                          "type": "string",
                          "enum": ["down"]
                        },
                        {
                          "type": "string",
                          "enum": ["disabled"]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "version", "database", "redis"],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": ["ok"]
                        },
                        {
                          "type": "string",
                          "enum": ["degraded"]
                        }
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "database": {
                      "type": "boolean"
                    },
                    "redis": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": ["ok"]
                        },
                        {
                          "type": "string",
                          "enum": ["down"]
                        },
                        {
                          "type": "string",
                          "enum": ["disabled"]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rooms": {
      "get": {
        "summary": "Salas cadastradas e quantos jogadores há em cada uma",
        "tags": ["salas"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["rooms"],
                  "properties": {
                    "rooms": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "mode",
                          "preset",
                          "hasPassword",
                          "maxPlayers",
                          "players",
                          "map",
                          "online"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "mode": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": ["casual"]
                              },
                              {
                                "type": "string",
                                "enum": ["ranked"]
                              }
                            ]
                          },
                          "preset": {
                            "type": "string"
                          },
                          "hasPassword": {
                            "type": "boolean"
                          },
                          "maxPlayers": {
                            "type": "integer"
                          },
                          "players": {
                            "type": "integer"
                          },
                          "map": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "online": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/rooms/heartbeat": {
      "post": {
        "summary": "Game server informa as salas que hospeda (a cada ~10 s)",
        "tags": ["interno"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rooms"],
                "properties": {
                  "rooms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "mode",
                        "preset",
                        "maxPlayers",
                        "persistent",
                        "players",
                        "map",
                        "wsUrl"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "mode": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": ["casual"]
                            },
                            {
                              "type": "string",
                              "enum": ["ranked"]
                            }
                          ]
                        },
                        "preset": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "maxPlayers": {
                          "type": "integer",
                          "minimum": 2,
                          "maximum": 32
                        },
                        "persistent": {
                          "type": "boolean"
                        },
                        "players": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 32
                        },
                        "map": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "wsUrl": {
                          "type": "string",
                          "pattern": "^wss?://",
                          "maxLength": 200
                        }
                      }
                    },
                    "maxItems": 64
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "gameServerHmac": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["updated"],
                  "properties": {
                    "updated": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "message"],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "message"],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/matches": {
      "post": {
        "summary": "Resultado de uma partida encerrada (idempotente por serverMatchId)",
        "tags": ["interno"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "serverMatchId",
                  "mode",
                  "ranked",
                  "map",
                  "redScore",
                  "blueScore",
                  "startedAt",
                  "endedAt",
                  "players"
                ],
                "properties": {
                  "serverMatchId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "roomId": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                  },
                  "mode": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["casual"]
                      },
                      {
                        "type": "string",
                        "enum": ["ranked"]
                      }
                    ]
                  },
                  "ranked": {
                    "type": "boolean"
                  },
                  "map": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "redScore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32767
                  },
                  "blueScore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32767
                  },
                  "startedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "players": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "slot",
                        "name",
                        "team",
                        "isBot",
                        "frags",
                        "kills",
                        "deaths",
                        "captures",
                        "playSeconds",
                        "scoreDelta",
                        "negDelta",
                        "stats"
                      ],
                      "properties": {
                        "slot": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 31
                        },
                        "userId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "team": {
                          "anyOf": [
                            {
                              "type": "number",
                              "enum": [0]
                            },
                            {
                              "type": "number",
                              "enum": [1]
                            }
                          ]
                        },
                        "isBot": {
                          "type": "boolean"
                        },
                        "frags": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        },
                        "kills": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "deaths": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "captures": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "playSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "scoreDelta": {
                          "type": "number",
                          "minimum": 0
                        },
                        "negDelta": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "stats": {
                          "type": "object",
                          "maxProperties": 64,
                          "additionalProperties": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "maxItems": 32
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "gameServerHmac": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "duplicate"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "duplicate": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "duplicate"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "duplicate": {
                      "type": "boolean",
                      "enum": [false]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "message"],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "message"],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
