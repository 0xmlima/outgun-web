{
  "name": "@outgun/game-server",
  "version": "2.50.1",
  "private": true,
  "description": "Servidor de jogo autoritativo, salas e loop de 10 Hz (card OG-040).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/rooms.d.ts",
      "default": "./dist/rooms.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@outgun/bots": "workspace:*",
    "@outgun/content": "workspace:*",
    "@outgun/netcode": "workspace:*",
    "@outgun/observability": "workspace:*",
    "@outgun/protocol": "workspace:*",
    "@outgun/settings": "workspace:*",
    "@outgun/sim": "workspace:*",
    "@outgun/tickets": "workspace:*",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
