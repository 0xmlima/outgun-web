+void endBotDecision(const std::string& before, const std::string& after) throw () {
+    botCapturing = false;
+    std::string line = "{\"type\":\"bot\",\"before\":" + before + ",\"rand\":[";
+    for (unsigned i = 0; i < botRand.size(); ++i) {
