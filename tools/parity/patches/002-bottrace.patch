+std::string Robot::oracleBotState(bool full) const throw () {
+    std::ostringstream o;
+    const int area0 = -1;
+    #define AREA(a) ((a) ? areaMap.areaIndex(a) : area0)
+    o << "{\"frame\":" << oNum(fx.frame) << ",\"me\":" << me;
+    // estado prÛprio do bot
+    o << ",\"bot\":{\"destinationType\":" << int(destinationType) << ",\"destination\":" << AREA(destination);
+    int immArea = -1, immIndex = -1;
+    if (immediateDestination)
+        for (int a = 0; a < areaMap.areaCount() && immArea == -1; ++a) {
+            const std::vector<Area::Neighbor>& ns = areaMap.areaAt(a).neighbors();
+            for (unsigned n = 0; n < ns.size(); ++n)
+                if (&ns[n] == immediateDestination) { immArea = a; immIndex = n; break; }
+        }
+    o << ",\"immediate\":[" << immArea << "," << immIndex << "]"
+      << ",\"lastSeen\":" << last_seen << ",\"myGundir\":" << myGundir
+      << ",\"freeWalkTarget\":" << oVec(freeWalkTarget) << ",\"enemiesInRoom\":" << enemiesInRoom
+      << ",\"prevFire\":" << botPrevFire << ",\"gunDir\":" << oNum(oGun(gunDir)) << ",\"tables\":[";
+    for (int t = 0; t < Table_Max; ++t)
+        o << (t ? "," : "") << "[" << AREA(distanceTable[t].center) << "," << oNum(distanceTable[t].center ? distanceTable[t].respawnWeight : 0.) << "]";
+    o << "]}";
+    o << ",\"seen\":[";
+    for (int x = 0; x < fx.map.w; ++x)
+        for (int y = 0; y < fx.map.h; ++y)
+            o << (x || y ? "," : "") << oNum(fx.map[RoomCoords(x, y)].enemies_seen_frame);
+    o << "],\"players\":[";
+    for (int i = 0; i < maxplayers; ++i) {
+        const ClientPlayer& p = fx.player[i];
+        o << (i ? "," : "") << "{\"used\":" << p.used;
+        if (p.used) {
+            o << ",\"dead\":" << p.dead << ",\"team\":" << p.team() << ",\"pos\":" << oCoords(p.pos) << ",\"vel\":" << oVec(p.vel)
+              << ",\"posUpdated\":" << oNum(p.posUpdated) << ",\"defending\":" << p.defending << ",\"defendingAfterDeath\":" << p.defendingAfterDeath;
+            if (full)
+                o << ",\"name\":" << oStr(p.name) << ",\"controls\":" << int(p.controls.toNetwork(false))
+                  << ",\"accelerationMode\":" << int(p.accelerationMode) << ",\"gundir\":" << oNum(oGun(p.gundir))
+                  << ",\"deathbringer\":" << p.item_deathbringer << ",\"deathbringerAffected\":" << p.deathbringer_affected
+                  << ",\"turbo\":" << p.item_turbo << ",\"onscreen\":" << p.onscreen << ",\"fromMinimapUpdate\":" << p.fromMinimapUpdate
+                  << ",\"prevMapPosUpdateFrame\":" << oNum(p.prevMapPosUpdateFrame)
+                  << ",\"prevMapUpdateRoom\":[" << p.prevMapUpdateRoom.x << "," << p.prevMapUpdateRoom.y << "]"
+                  << ",\"shadowTime\":" << oNum(p.item_shadow_time) << ",\"weapon\":" << p.weapon;
+        }
+        o << "}";
+    }
+    o << "]";
+    if (full) {
+        o << ",\"maxplayers\":" << maxplayers
+          << ",\"hidden\":" << (!map_ready || gameover_plaque != NEXTMAP_NONE || fx.skipped || me < 0 || me >= maxplayers)
+          << ",\"clFrameSent\":" << int(clFrameSent) << ",\"clFrameWorld\":" << int(clFrameWorld) << ",\"controlHistory\":[";
+        // sÛ a parte usada pela extrapolaÁ„o de RobotMain: clFrameWorld + 1 .. clFrameSent (ou sÛ clFrameSent)
+        const uint8_t firstCtrl = clFrameSent == clFrameWorld ? clFrameSent : uint8_t(clFrameWorld + 1);
+        for (uint8_t i = firstCtrl; ; ++i) {
+            o << (i != firstCtrl ? "," : "") << int(controlHistory[i].toNetwork(false));
+            if (i == clFrameSent)
+                break;
+        }
+        o << "],\"settings\":{\"carryOwnTeamFlag\":" << carry_own_team_flag << ",\"captureAwayFromBase\":" << capture_away_from_base
+          << ",\"lockTeamFlags\":" << lock_team_flags_in_effect << ",\"lockWildFlags\":" << lock_wild_flags_in_effect
+          << ",\"captureOnTeamFlags\":" << capture_on_team_flags_in_effect << ",\"captureOnWildFlags\":" << capture_on_wild_flags_in_effect
+          << ",\"seeMinimapPlayerProperties\":" << see_minimap_player_properties << "}";
+        const PhysicalSettings& ph = fx.physics;
+        o << ",\"physics\":{\"fric\":" << oNum(ph.fric) << ",\"drag\":" << oNum(ph.drag) << ",\"accel\":" << oNum(ph.accel)
+          << ",\"brakeMul\":" << oNum(ph.brake_mul) << ",\"turnMul\":" << oNum(ph.turn_mul) << ",\"runMul\":" << oNum(ph.run_mul)
+          << ",\"turboMul\":" << oNum(ph.turbo_mul) << ",\"flagMul\":" << oNum(ph.flag_mul) << ",\"rocketSpeed\":" << oNum(ph.rocket_speed)
+          << ",\"friendlyFire\":" << oNum(ph.friendly_fire) << ",\"friendlyDb\":" << oNum(ph.friendly_db)
+          << ",\"playerCollisions\":" << int(ph.player_collisions) << ",\"allowFreeTurning\":" << ph.allowFreeTurning
+          << ",\"maxRunSpeed\":" << oNum(ph.max_run_speed) << "}";
+        o << ",\"rockets\":[";
+        bool first = true;
+        for (int i = 0; i < MAX_ROCKETS; ++i) {
+            const Rocket& r = fx.rock[i];
+            if (r.owner == -1)
+                continue;
+            o << (first ? "" : ",") << "{\"id\":" << i << ",\"owner\":" << r.owner << ",\"team\":" << r.team << ",\"power\":" << r.power
+              << ",\"pos\":" << oCoords(r.pos) << ",\"vel\":" << oVec(r.vel) << "}";
+            first = false;
+        }
+        o << "],\"powerups\":[";
+        first = true;
+        for (int i = 0; i < MAX_POWERUPS; ++i) {
+            const Powerup& p = fx.item[i];
+            if (p.kind == Powerup::pup_unused)
+                continue;
+            o << (first ? "" : ",") << "{\"id\":" << i << ",\"kind\":" << int(p.kind) << ",\"pos\":" << oCoords(p.pos) << "}";
+            first = false;
+        }
+        o << "],\"flags\":[";
+        for (int t = 0; t <= 2; ++t) {
+            const std::vector<Flag>& flags = t == 2 ? fx.wild_flags : fx.teams[t].flags();
+            o << (t ? "," : "") << "[";
+            for (unsigned f = 0; f < flags.size(); ++f)
+                o << (f ? "," : "") << "{\"carried\":" << flags[f].carried() << ",\"atBase\":" << flags[f].at_base()
+                  << ",\"carrier\":" << flags[f].carrier() << ",\"pos\":" << oCoords(flags[f].position()) << "}";
+            o << "]";
+        }
+        o << "],\"bases\":[";
+        for (int t = 0; t <= 2; ++t) {
+            const std::vector<WorldCoords>& bases = t == 2 ? fx.map.wild_flags : fx.map.tinfo[t].flags;
+            o << (t ? "," : "") << "[";
+            for (unsigned b = 0; b < bases.size(); ++b)
+                o << (b ? "," : "") << oCoords(bases[b]);
+            o << "]";
+        }
+        o << "],\"explosions\":[";
+        first = true;
+        for (std::list<DeathbringerExplosion>::const_iterator di = fx.deathbringerExplosions().begin(); di != fx.deathbringerExplosions().end(); ++di) {
+            DeathbringerExplosionMirror m;
+            std::memcpy(&m, &*di, sizeof m);
+            o << (first ? "" : ",") << "{\"frame0\":" << oNum(m.frame0) << ",\"pos\":" << oCoords(di->position()) << ",\"team\":" << di->team() << "}";
+            first = false;
+        }
+        o << "]";
+    }
+    #undef AREA
+    o << "}";
+    return o.str();
 }
 
