+// Outgun Web (OG-051..053): registro das decisıes dos bots para o harness de paridade. SÛ È usado com
+// a diretiva "bottrace" no roteiro do or·culo; n„o muda o comportamento dos bots.
+namespace {
+
+std::string oNum(double v) {
+    char buf[40];
+    std::sprintf(buf, "%.17g", v);
+    return buf;
+}
+
+double oGun(const GunDirection& g) {
+    double d;
+    std::memcpy(&d, &g, sizeof d);
+    return d;
+}
+
+std::string oCoords(const WorldCoords& c) {
+    return "[" + oNum(c.room.x) + "," + oNum(c.room.y) + "," + oNum(c.x) + "," + oNum(c.y) + "]";
+}
+
+std::string oVec(const Vec& v) {
+    return "[" + oNum(v.x) + "," + oNum(v.y) + "]";
+}
+
+std::string oStr(const std::string& s) {
+    std::string r = "\"";
+    for (std::string::size_type i = 0; i < s.size(); ++i) {
+        const unsigned char c = s[i];
+        char buf[8];
+        if (c == '"' || c == '\\') { r += '\\'; r += c; }
+        else if (c < 0x20 || c >= 0x7F) { std::sprintf(buf, "\\u%04x", c); r += buf; }
+        else r += c;
+    }
+    return r + "\"";
+}
+
+struct DeathbringerExplosionMirror {
+    double frame0;
+    WorldCoords pos;
+    int ownerPid;
+    int ownerTeam;
+    uint32_t playersOutsideMask;
+};
+
+} // namespace
