+
+// Leitura de campos privados para serialização (não altera o layout das classes).
+#define private public
+#define protected public
+#include "world.h"
+#include "timer.h"
+#undef private
+#undef protected
+
+#include "trace.h"
+
+namespace {
+
+// Classes sem rótulo de acesso (privadas por padrão) são lidas por espelhos de mesmo layout.
+double gunData(const GunDirection& g) {
+    double d;
+    std::memcpy(&d, &g, sizeof d);
+    return d;
+}
+
+void setGunData(GunDirection& g, double d) {
+    std::memcpy(&g, &d, sizeof d);
+}
+
+struct DeathbringerMirror {
+    double frame0;
+    WorldCoords pos;
+    int ownerPid;
+    int ownerTeam;
+    uint32_t playersOutsideMask;
+};
+
+struct Action {     // "at F PID campo valores..."
+    int pid;
+    std::string field;
+    std::vector<double> values;
+};
+
+struct Input {      // "input F PID CONTROLES ATIRANDO"
+    int controls;
+    bool attack;
+};
+
+FILE* out = 0;
+std::string scriptPath;
+unsigned startFrame = 0, frameCount = 0, recorded = 0;
+unsigned seed = 1;
+bool started = false;
+std::set<int> scripted;
+std::multimap<unsigned, Action> actions;
+std::map<int, std::map<unsigned, Input> > inputs; // pid -> frame -> entrada (vale até a próxima)
+
+volatile bool capturing = false;
+pthread_t simThread;
+std::vector<int> randValues;
+
+std::string jstr(const std::string& s) {
+    std::string r = "\"";
+    for (std::string::size_type i = 0; i < s.size(); ++i) {
+        const unsigned char c = s[i];
+        char buf[8];
+        if (c == '"' || c == '\\') { r += '\\'; r += c; }
+        else if (c < 0x20 || c >= 0x7F) { std::sprintf(buf, "\\u%04x", c); r += buf; }
+        else r += c;
+    }
+    return r + "\"";
+}
+
+std::string num(double v) {
+    char buf[40];
+    std::sprintf(buf, "%.17g", v);
+    return buf;
+}
+
+std::string coords(const WorldCoords& c) {
+    std::ostringstream o;
+    o << '[' << c.room.x << ',' << c.room.y << ',' << num(c.x) << ',' << num(c.y) << ']';
+    return o.str();
+}
+
+std::string stats(const Statistics& s) {
+    std::ostringstream o;
+    o << "{\"frags\":" << s.total_frags << ",\"kills\":" << s.total_kills << ",\"deaths\":" << s.total_deaths
+      << ",\"dbKills\":" << s.total_deathbringer_kills << ",\"dbDeaths\":" << s.total_deathbringer_deaths
+      << ",\"consKills\":" << s.most_consecutive_kills << ",\"curConsKills\":" << s.current_consecutive_kills
+      << ",\"consDeaths\":" << s.most_consecutive_deaths << ",\"curConsDeaths\":" << s.current_consecutive_deaths
+      << ",\"suicides\":" << s.total_suicides << ",\"captures\":" << s.total_captures << ",\"assists\":" << s.total_assists
+      << ",\"flagsTaken\":" << s.total_flags_taken << ",\"flagsDropped\":" << s.total_flags_dropped
+      << ",\"flagsReturned\":" << s.total_flags_returned << ",\"carriersKilled\":" << s.total_flag_carriers_killed
+      << ",\"shots\":" << s.total_shots << ",\"hits\":" << s.total_hits << ",\"shotsTaken\":" << s.total_shots_taken
+      << ",\"spawnTime\":" << num(s.last_spawn_time) << ",\"lifetime\":" << num(s.total_lifetime)
+      << ",\"movement\":" << num(s.total_movement) << ",\"startTime\":" << num(s.starttime)
+      << ",\"dead\":" << s.dead << ",\"carriedFlag\":" << s.carriedFlag
+      << ",\"flagCarryingTime\":" << num(s.total_flag_carrying_time) << ",\"flagTakeTime\":" << num(s.flag_taking_time) << '}';
+    return o.str();
+}
+
+std::string player(const ServerPlayer& p) {
+    std::ostringstream o;
+    o << "{\"pid\":" << p.pid << ",\"team\":" << p.team_nr << ",\"bot\":" << p.bot << ",\"dead\":" << p.dead
+      << ",\"pos\":" << coords(p.pos) << ",\"vel\":[" << num(p.vel.x) << ',' << num(p.vel.y) << ']'
+      << ",\"controls\":" << int(p.controls.data) << ",\"accelerationMode\":" << int(p.accelerationMode)
+      << ",\"gundir\":" << num(gunData(p.gundir)) << ",\"attack\":" << p.attack << ",\"attackOnce\":" << p.attackOnce
+      << ",\"attackGunDir\":" << num(gunData(p.attackGunDir))
+      << ",\"health\":" << num(p.health) << ",\"energy\":" << num(p.energy) << ",\"megabonus\":" << p.megabonus
+      << ",\"weapon\":" << p.weapon << ",\"shield\":" << p.item_shield << ",\"power\":" << p.item_power
+      << ",\"turbo\":" << p.item_turbo << ",\"visibility\":" << p.visibility << ",\"deathbringer\":" << p.item_deathbringer
+      << ",\"powerTime\":" << num(p.item_power_time) << ",\"turboTime\":" << num(p.item_turbo_time)
+      << ",\"shadowTime\":" << num(p.item_shadow_time) << ",\"deathbringerEnd\":" << num(p.deathbringer_end)
+      << ",\"deathbringerAttacker\":" << p.deathbringer_attacker
+      << ",\"nextShootFrame\":" << p.next_shoot_frame << ",\"startTakeDamageFrame\":" << p.start_take_damage_frame
+      << ",\"framesToRespawn\":" << p.frames_to_respawn << ",\"extraFramesToRespawn\":" << p.extra_frames_to_respawn
+      << ",\"respawnToBase\":" << p.respawn_to_base << ",\"dropKey\":" << p.drop_key << ",\"droppedFlag\":" << p.dropped_flag
+      << ",\"awaitingClientReadies\":" << p.awaiting_client_readies << ",\"wantChangeTeams\":" << p.want_change_teams
+      << ",\"color\":" << p.personal_color << ",\"stats\":" << stats(p.player_stats) << '}';
+    return o.str();
+}
