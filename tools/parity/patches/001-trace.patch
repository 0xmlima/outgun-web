+/*
+ *  trace.cpp - Outgun Web: gravação de golden traces para o harness de paridade (card OG-003).
+ *  Não faz parte do Outgun original; aplicado como patch só dentro do oráculo Docker.
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ *  Para cada frame a partir de "start": estado completo antes (pre) e depois (post) de
+ *  ServerWorld::simulateFrame, o valor de get_time() e todos os rand() consumidos pela thread da
+ *  simulação durante o frame (via -Wl,--wrap=rand). O formato está em tools/parity/trace-schema.md.
+ */
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
