+      << ",\"prevPrevCarrier\":" << f.prev_prev_carrier_id << ",\"grabTime\":" << num(f.grab_t)
+      << ",\"dropTime\":" << num(f.drop_t) << ",\"home\":" << coords(f.home_pos) << ",\"pos\":" << coords(f.pos)
+      << ",\"carryingTeam\":" << f.cteam << ",\"carryingTime\":" << f.ctime << '}';
+    return o.str();
+}
+
+std::string state(const ServerWorld& w) {
+    std::ostringstream o;
+    o << "{\"frame\":" << w.frame << ",\"time\":" << num(get_time()) << ",\"mapStartTime\":" << w.map_start_time
+      << ",\"players\":[";
+    bool first = true;
+    for (int i = 0; i < w.maxplayers; ++i)
+        if (w.player[i].used) {
+            o << (first ? "" : ",") << player(w.player[i]);
+            first = false;
+        }
+    o << "],\"rockets\":[";
+    first = true;
+    for (int i = 0; i < MAX_ROCKETS; ++i) {
+        const Rocket& r = w.rock[i];
+        if (r.owner == -1)
+            continue;
+        o << (first ? "" : ",") << "{\"id\":" << i << ",\"owner\":" << r.owner << ",\"team\":" << r.team << ",\"power\":" << r.power
+          << ",\"pos\":" << coords(r.pos) << ",\"vel\":[" << num(r.vel.x) << ',' << num(r.vel.y) << "],\"direction\":" << num(gunData(r.direction)) << '}';
+        first = false;
+    }
+    o << "],\"powerups\":[";
+    first = true;
+    for (int i = 0; i < MAX_POWERUPS; ++i) {
+        const Powerup& p = w.item[i];
+        if (p.kind == Powerup::pup_unused)
+            continue;
+        o << (first ? "" : ",") << "{\"id\":" << i << ",\"kind\":" << int(p.kind) << ",\"respawnTime\":" << num(p.respawn_time) << ",\"pos\":" << coords(p.pos) << '}';
+        first = false;
+    }
+    o << "],\"teams\":[";
+    for (int t = 0; t < 2; ++t) {
+        const Team& team = w.teams[t];
+        o << (t ? "," : "") << "{\"score\":" << team.points << ",\"kills\":" << team.total_kills << ",\"deaths\":" << team.total_deaths
+          << ",\"suicides\":" << team.total_suicides << ",\"flagsTaken\":" << team.total_flags_taken << ",\"flagsDropped\":" << team.total_flags_dropped
+          << ",\"flagsReturned\":" << team.total_flags_returned << ",\"shots\":" << team.total_shots << ",\"hits\":" << team.total_hits
+          << ",\"shotsTaken\":" << team.total_shots_taken << ",\"movement\":" << num(team.total_movement) << ",\"flags\":[";
+        for (unsigned f = 0; f < team.team_flags.size(); ++f)
+            o << (f ? "," : "") << flag(team.team_flags[f]);
+        o << "],\"captures\":[";
+        for (unsigned c = 0; c < team.caps.size(); ++c)
+            o << (c ? "," : "") << '[' << team.caps[c].first << ',' << jstr(team.caps[c].second) << ']';
+        o << "]}";
+    }
+    o << "],\"wildFlags\":[";
+    for (unsigned f = 0; f < w.wild_flags.size(); ++f)
+        o << (f ? "," : "") << flag(w.wild_flags[f]);
+    o << "],\"deathbringers\":[";
+    first = true;
+    for (std::list<DeathbringerExplosion>::const_iterator dbi = w.dbExplosions.begin(); dbi != w.dbExplosions.end(); ++dbi) {
+        const DeathbringerMirror* db = reinterpret_cast<const DeathbringerMirror*>(&*dbi);
+        o << (first ? "" : ",") << "{\"frame0\":" << num(db->frame0) << ",\"pos\":" << coords(db->pos) << ",\"owner\":" << db->ownerPid
+          << ",\"team\":" << db->ownerTeam << ",\"outsideMask\":" << db->playersOutsideMask << '}';
+        first = false;
+    }
+    o << "]}";
+    return o.str();
+}
