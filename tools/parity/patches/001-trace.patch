+      << "\"team_power\":" << int64_t(p.team_power) << ","
+      << "\"team_weapon\":" << int64_t(p.team_weapon) << ","
+      << "\"team_health\":" << int64_t(p.team_health) << ","
+      << "\"team_deathbringer\":" << int64_t(p.team_deathbringer) << "},\"physics\":{" << "\"fric\":" << num(ph.fric) << ","
+      << "\"drag\":" << num(ph.drag) << ","
+      << "\"accel\":" << num(ph.accel) << ","
+      << "\"brake_mul\":" << num(ph.brake_mul) << ","
+      << "\"turn_mul\":" << num(ph.turn_mul) << ","
+      << "\"run_mul\":" << num(ph.run_mul) << ","
+      << "\"turbo_mul\":" << num(ph.turbo_mul) << ","
+      << "\"flag_mul\":" << num(ph.flag_mul) << ","
+      << "\"rocket_speed\":" << num(ph.rocket_speed) << ","
+      << "\"friendly_fire\":" << num(ph.friendly_fire) << ","
+      << "\"friendly_db\":" << num(ph.friendly_db) << ","
+      << "\"max_run_speed\":" << num(ph.max_run_speed) << ","
+      << "\"player_collisions\":" << int64_t(ph.player_collisions) << ","
+      << "\"allowFreeTurning\":" << int64_t(ph.allowFreeTurning) << "}}";
+    return o.str();
+}
+
+std::string readFile(const std::string& path) {
+    std::ifstream in(path.c_str(), std::ios::binary);
+    std::ostringstream o;
+    o << in.rdbuf();
+    return o.str();
+}
+
+void loadScript() {
+    std::ifstream in(scriptPath.c_str());
+    std::string line;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line[line.size() - 1] == '\r')
+            line.erase(line.size() - 1);
+        std::istringstream ist(line);
+        std::string cmd;
+        if (!(ist >> cmd) || cmd[0] == '#')
+            continue;
+        if (cmd == "start") ist >> startFrame;
+        else if (cmd == "frames") ist >> frameCount;
+        else if (cmd == "seed") ist >> seed;
+        else if (cmd == "players") { int p; while (ist >> p) scripted.insert(p); }
+        else if (cmd == "at") {
+            unsigned f;
+            Action a;
+            ist >> f >> a.pid >> a.field;
+            double v;
+            while (ist >> v) a.values.push_back(v);
+            actions.insert(std::make_pair(f, a));
+        }
+        else if (cmd == "input") {
+            unsigned f;
+            int pid, c, att;
+            ist >> f >> pid >> c >> att;
+            Input in2 = { c, att != 0 };
+            inputs[pid][f] = in2;
+        }
+        // map, bots, gamemod: lidos pelo entrypoint do oráculo
+    }
+}
+
+double value(const Action& a, unsigned i) {
+    return i < a.values.size() ? a.values[i] : 0.;
+}
+
+void applyAction(ServerWorld& w, const Action& a) {
+    ServerPlayer& p = w.player[a.pid];
+    if (a.field == "pos") { p.pos = WorldCoords(int(value(a, 0)), int(value(a, 1)), value(a, 2), value(a, 3)); p.record_position = true; }
+    else if (a.field == "vel") p.vel = Vec(value(a, 0), value(a, 1));
+    else if (a.field == "health") p.health = value(a, 0);
+    else if (a.field == "energy") p.energy = value(a, 0);
+    else if (a.field == "weapon") p.weapon = int(value(a, 0));
+    else if (a.field == "gundir") { setGunData(p.gundir, value(a, 0)); setGunData(p.attackGunDir, value(a, 0)); }
+    else if (a.field == "shield") p.item_shield = int(value(a, 0));
+    else if (a.field == "deathbringer") p.item_deathbringer = value(a, 0) != 0;
+    else if (a.field == "power") { p.item_power = true; p.item_power_time = get_time() + value(a, 0); }
+    else if (a.field == "turbo") { p.item_turbo = true; p.item_turbo_time = get_time() + value(a, 0); }
+    else if (a.field == "shadow") { p.set_visibility(w.getConfig().getShadowMinimum()); p.item_shadow_time = get_time() + value(a, 0); }
+    p.record_powerups = true;
+}
+
+// Mesma semântica de ServerNetworking::incoming_client_data + data_fire_on/off.
+void applyInput(ServerPlayer& p, const Input& in) {
+    ClientControls c;
+    c.fromNetwork(uint8_t(in.controls), false);
+    c.clearModifiersIfIdle();
+    p.controls = c;
+    p.accelerationMode = AM_World;
+    if (!p.dead && !p.controls.isStrafe()) {
+        GunDirection d = p.gundir;
+        d.updateFromControls(p.controls);
+        p.gundir = d;
+    }
+    if (in.attack && !p.attack) {
+        p.attackOnce = p.attack = true;
+        p.attackGunDir = p.gundir;
+    }
+    else if (!in.attack)
+        p.attack = false;
+    if (!p.attackOnce)
+        p.attackGunDir = p.gundir;
+}
+
+} // namespace
+
+extern "C" int __real_rand(void);
+extern "C" int __wrap_rand(void) {
+    const int v = __real_rand();
+    if (capturing && pthread_equal(pthread_self(), simThread))
+        randValues.push_back(v);
+    return v;
+}
+
+namespace OracleTrace {
+
+void setOutput(const std::string& outFile) throw () {
+    out = std::fopen(outFile.c_str(), "w");
+}
+
+void setScript(const std::string& scriptFile) throw () {
+    scriptPath = scriptFile;
+    loadScript();
+}
+
+bool enabled() throw () { return out != 0; }
+
+bool isScripted(int pid) throw () { return out && scripted.count(pid); }
+
+void beforeFrame(ServerWorld& w) throw () {
+    if (!out || w.frame < startFrame)
+        return;
+    if (!started) {
+        started = true;
+        std::srand(seed);
+        std::fprintf(out, "{\"type\":\"header\",\"version\":1,\"seed\":%u,\"startFrame\":%u,\"maxplayers\":%d,\"mapTitle\":%s,\"mapCrc\":%u,\"gamemod\":%s,\"script\":%s,\"settings\":%s}\n",
+                     seed, w.frame, w.maxplayers, jstr(w.map.title).c_str(), unsigned(w.map.crc),
+                     jstr(readFile(wheregamedir + "config/gamemod.txt")).c_str(), jstr(readFile(scriptPath)).c_str(), settings(w).c_str());
+    }
+    for (std::multimap<unsigned, Action>::const_iterator a = actions.lower_bound(w.frame); a != actions.upper_bound(w.frame); ++a)
+        applyAction(w, a->second);
+    for (std::map<int, std::map<unsigned, Input> >::const_iterator pi = inputs.begin(); pi != inputs.end(); ++pi) {
+        std::map<unsigned, Input>::const_iterator in = pi->second.upper_bound(w.frame);
+        if (in != pi->second.begin() && w.player[pi->first].used)
+            applyInput(w.player[pi->first], (--in)->second);
+    }
+    std::fprintf(out, "{\"type\":\"frame\",\"frame\":%u,\"pre\":%s,", w.frame, state(w).c_str());
+    randValues.clear();
+    simThread = pthread_self();
+    capturing = true;
+}
+
+bool afterFrame(ServerWorld& w) throw () {
+    if (!out || !capturing)
+        return false;
+    capturing = false;
+    std::fprintf(out, "\"rand\":[");
+    for (unsigned i = 0; i < randValues.size(); ++i)
+        std::fprintf(out, "%s%d", i ? "," : "", randValues[i]);
+    std::fprintf(out, "],\"post\":%s}\n", state(w).c_str());
+    if (frameCount && ++recorded >= frameCount) {
+        std::fclose(out);
+        out = 0;
+        return true;
+    }
+    return false;
+}
+
+} // namespace OracleTrace
