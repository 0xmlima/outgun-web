{
  "name": "@outgun/asset-pipeline",
  "version": "2.50.0",
  "private": true,
  "description": "Converte gráficos (PCX) e sons (WAV) do Outgun original para a web e gera o manifesto (card OG-012).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
