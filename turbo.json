{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/parity/traces/**",
        "$TURBO_ROOT$/tools/parity/scenarios/**",
        "$TURBO_ROOT$/_legacy/maps/**",
        "$TURBO_ROOT$/_legacy/config/**",
        "$TURBO_ROOT$/_legacy/languages/**"
      ]
    }
  }
}
