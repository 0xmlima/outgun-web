# Borda HTTPS da VPS (OG-109). Certificado automático para DOMAIN (Let's Encrypt, sem e-mail).
# DOMAIN_ALIASES (opcional, separados por espaço; OG-304): outros nomes, cada um com certificado
# próprio, que redirecionam para DOMAIN (ex.: www e o endereço sslip.io antigo).

{$DOMAIN} {$DOMAIN_ALIASES} {
	encode zstd gzip
	# HSTS em todas as respostas, não só nas da API (OG-311, OWASP HTTP Strict Transport Security)
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	@alias not host {$DOMAIN}
	redir @alias https://{$DOMAIN}{uri} permanent
	# game server: WebSocket das salas, replays e /health (ping do lobby); /metrics não sai da máquina
	handle_path /gs/* {
		@metrics path /metrics
		respond @metrics 404
		reverse_proxy game-server:7700
	}
	handle {
		@metrics path /api/metrics
		respond @metrics 404
		reverse_proxy web:8080
	}
}
