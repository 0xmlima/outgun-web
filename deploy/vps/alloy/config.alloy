// SPDX-License-Identifier: GPL-2.0-or-later
// Grafana Alloy no servidor do beta (OG-452): coleta as métricas do jogo, da API, da máquina, dos
// containers e do banco (OG-453) e os logs dos containers, e envia ao Grafana Cloud (plano Free:
// 10 mil séries ativas, 50 GB de logs, 14 dias). Credenciais no /opt/outgun/.env, passadas pelo
// compose. Cada coleta descarta o que os painéis e alertas não usam, para caber no plano.

logging {
  level  = "warn"
  format = "logfmt"
}

// ---------------------------------------------------------------- envio

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
  external_labels = { host = "beta" }
}

loki.write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
  external_labels = { host = "beta" }
}

// ---------------------------------------------------------------- jogo e API (/metrics do OG-102)

prometheus.scrape "outgun" {
  targets = [
    {"__address__" = "game-server:7700", "job" = "game-server", "instance" = "vps"},
    {"__address__" = "api:7800", "job" = "api", "instance" = "api"},
  ]
  scrape_interval = "15s"

  authorization {
    type        = "Bearer"
    credentials = sys.env("METRICS_TOKEN")
  }
  forward_to = [prometheus.remote_write.cloud.receiver]
}

// ---------------------------------------------------------------- máquina
// Sem netdev: dentro do container, /proc/net é a rede do próprio container (a da VM vem da Oracle).

prometheus.exporter.unix "host" {
  procfs_path    = "/host/proc"
  sysfs_path     = "/sys"
  rootfs_path    = "/rootfs"
  set_collectors = ["cpu", "loadavg", "meminfo", "vmstat", "pressure", "filesystem", "diskstats", "stat", "uname"]

  filesystem {
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+|snap/.+)($|/)"
    fs_types_exclude     = "^(tmpfs|devtmpfs|overlay|squashfs|nsfs|proc|sysfs|cgroup2?|autofs|fuse.*)$"
  }

  disk {
    device_include = "^(sd[a-z]+|vd[a-z]+|nvme[0-9]+n[0-9]+)$"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "node"
  }

  rule {
    target_label = "instance"
    replacement  = "beta"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.host.receiver]
}

// vmstat e meminfo trazem dezenas de campos; ficam os de memória, swap e falta de página
prometheus.relabel "host" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_(vmstat_(pgmajfault|pswpin|pswpout|oom_kill)|memory_(MemTotal|MemAvailable|MemFree|Buffers|Cached|SwapTotal|SwapFree|Dirty)_bytes|(cpu|disk|filesystem|load|pressure|boot|context|forks|procs|intr|uname)_.*)"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.cloud.receiver]
}

// ---------------------------------------------------------------- containers (CPU, memória, rede, OOM)

prometheus.exporter.cadvisor "containers" {
  docker_host                   = "unix:///var/run/docker.sock"
  docker_only                   = true
  storage_duration              = "1m"
  store_container_labels        = false
  allowlisted_container_labels  = ["com.docker.compose.service"]
  enabled_metrics               = ["cpu", "memory", "network", "oom_event"]
}

discovery.relabel "containers" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "job"
    replacement  = "containers"
  }

  rule {
    target_label = "instance"
    replacement  = "beta"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
  // só os containers do jogo, com o nome do serviço do compose como rótulo
  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    regex         = ".+"
    action        = "keep"
  }

  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    regex  = "id|image|name|container_label_com_docker_compose_service"
    action = "labeldrop"
  }

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|cpu_cfs_throttled_seconds_total|memory_working_set_bytes|memory_rss|memory_swap|memory_failcnt|spec_memory_limit_bytes|network_(receive|transmit)_bytes_total|oom_events_total|last_seen)"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.cloud.receiver]
}

// ---------------------------------------------------------------- banco (OG-453)
// Papel outgun_monitor (pg_monitor): lê as visões de estatística, não as tabelas do jogo.

prometheus.exporter.postgres "db" {
  data_source_names  = [sys.env("MONITOR_DATABASE_URL")]
  enabled_collectors = ["database", "locks", "long_running_transactions", "postmaster", "stat_bgwriter", "stat_database", "stat_statements", "stat_user_tables", "wal"]

  autodiscovery {
    enabled = false
  }

  stat_statements {
    include_query = true
    query_length  = 160
  }
}

discovery.relabel "db" {
  targets = prometheus.exporter.postgres.db.targets

  rule {
    target_label = "job"
    replacement  = "postgres"
  }

  rule {
    target_label = "instance"
    replacement  = "beta"
  }
}

prometheus.scrape "db" {
  targets         = discovery.relabel.db.output
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.db.receiver]
}

// das tabelas, só o que diz se uma query faz varredura ou se o autovacuum está atrasado
prometheus.relabel "db" {
  rule {
    source_labels = ["__name__"]
    regex         = "pg_stat_user_tables_(.+)"
    replacement   = "$1"
    target_label  = "__tmp_table_metric"
  }

  rule {
    source_labels = ["__tmp_table_metric"]
    regex         = "|seq_scan|seq_tup_read|idx_scan|n_live_tup|n_dead_tup|last_autovacuum|size_bytes"
    action        = "keep"
  }

  rule {
    regex  = "__tmp_table_metric"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.cloud.receiver]
}

// ---------------------------------------------------------------- logs dos containers
// Os logs do json-file somem quando o deploy recria o container; aqui eles ficam 14 dias no Loki.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=outgun"]
  }
}

discovery.relabel "logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // os logs do próprio Alloy não vão ao Loki
  rule {
    source_labels = ["service"]
    regex         = "alloy"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.logs.rules
  labels        = {"job" = "outgun"}
  forward_to    = [loki.process.levels.receiver]
}

// API, game server e Caddy logam JSON com "level" em texto (pino: info, warn, error...)
loki.process "levels" {
  stage.json {
    expressions = {level = "level"}
  }

  stage.labels {
    values = {level = ""}
  }

  forward_to = [loki.write.cloud.receiver]
}
